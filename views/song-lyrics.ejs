<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Song Lyrics - Plumes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/song-lyrics.css">
</head>
<body>
    <header>
        <h2 class="logo"><i class="fa-solid fa-feather"></i> Plumes</h2>
        <nav>
            <ul class="nav-links">
                <li><a href="/profile">Profile</a></li>
                <li><a href="/recordings">Recordings</a></li>
                <li><a href="/art">Art</a></li>
                <li><a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Log out</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <section class="content">
            <h1>Song Lyrics</h1>
            <p>Write, store, and refine your song lyrics here.</p>
            <form action="/add-lyrics" method="POST">
                <input type="hidden" id="userEmail" value="<%= user.username %>">
                <div class="form-group">
                    <label for="title">Title:</label>
                    <input type="text" id="title" name="title" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="lyrics">Lyrics:</label>
                    <textarea id="lyrics" name="lyrics" class="form-control" rows="5" required></textarea>                </div>
                <button class="add-project-btn"><span class="plus-icon">➕</span> Add Lyrics</button>
            </form>
        </section>
        <section class="lyrics-list">
        <h3>(Highlight Your Favorites)</h3>
            <ul class="messages">
            <% for (var i = 0; i < songs.length; i++) { %>
                <li class="message">
                    <p><%= songs[i].title %></p>
                    <span><%= songs[i].lyrics %></span>
                    <span>
                        <i class="fa fa-star <%= songs[i].favorite ? 'favorite' : '' %>" aria-hidden="true"></i>
                    </span>
                    <span class="delete-btn">
                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                    </span>
                </li>
            <% } %>
            </ul>
        </section>
    </main>    
    <script src="main.js"></script>
</body>
</html>