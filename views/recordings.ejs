<!DOCTYPE html>
<html lang="en">
<head>
    <title>Recordings - Plumes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <header>
        <h2><i class="fa-solid fa-music"></i> Plumes</h2>
        <nav>
            <ul>
                <a href="/"></a><li>Home</li></a>
                <a href="/song-lyrics"><li>Song lyrics</li></a>
                <a href="/art"><li>Art</li></a>
            </ul>
        </nav>
    </header>

    <main>
        <section class="content">
            <h1>Recordings</h1>
            <p>Upload and store your musical recordings here.</p>
            <form action="/recordings" method="POST" enctype="multipart/form-data">
                <input type="file" name="file" accept="audio/*,image/*" required>
                <button type="submit">Upload</button>
            </form>    
            <!-- <button class="add-project-btn"><span class="plus-icon">➕</span> Add Recording</button> -->
        </section>
        <ul>
            <% for (var i = 0; i < recordings.length; i++) { %>
                <li>
                    <audio controls>
                        <source src="<%= recordings[i].fileUrl %>" type="audio/mp4"> <!--type="audio/mp3"-->
                    </audio>
                </li>
            <% } %>
        </ul>
    </main>
</body>
</html>