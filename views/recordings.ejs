<!DOCTYPE html>
<html lang="en">
<head>
    <title>Recordings - Plumes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/uploads.css">
</head>
<body>
    <header>
        <h2 class="logo"><i class="fa-solid fa-feather"></i> Plumes</h2>
        <nav>
            <ul class="nav-links">
                <li><a href="/profile">Profile</a></li>
                <li><a href="/song-lyrics">Song lyrics</a></li>
                <li><a href="/art">Art</a></li>
                <li><a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Log out</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <div class="image-holder">
            <img src="/img/band.webp" alt="" class="img">
            <p>"Melodies are the whispers of emotion, carried by sound, shaping the way we feel long before we understand why."</p>
        </div>
        <section class="content">
            <p>Recordings</p>
            <form action="/recordings" method="POST" enctype="multipart/form-data">
                <input type="hidden" id="userEmail" value="<%= user.username %>">
                <input type="file" name="file" accept="audio/*" required>
                <div class="form-group">
                    <label for="title">Title:</label>
                    <input type="text" id="title" name="title" class="form-control title" required>
                </div>
                <button class="add-project-btn" type="submit"><span class="plus-icon">➕</span> Add Recording</button>
            </form>    
        </section>
    </main>
    <section class="uploads-content">  
        <section class="uploads-list">
            <ul class="messages">
            <% for (var i = 0; i < recordings.length; i++) { %>
                <li class="message">
                    <p><%= recordings[i].title %></p>
                    <audio controls>
                        <source src="<%= recordings[i].fileUrl %>" type="audio/mp4"> <!--type="audio/mp3"-->
                    </audio>
                    <span>
                        <i class="fa fa-star star2 <%= recordings[i].favorite ? 'favorite' : '' %>" aria-hidden="true"></i>
                    </span>
                    <span>
                        <i class="fa-solid fa-trash trash2" aria-hidden="true"><span> Delete</span></i>
                    </span>
                </li>
            <% } %>
            </ul>
        </section> 
    </section>
    <script src="main.js"></script>
</body>
</html>